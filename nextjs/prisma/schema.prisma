model BankIntegration {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  bank       String   // KHAN | GOLOMT | TDB | HAS | ARIG | CAPITRON
  apiKey     String
  merchantId String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@map("bank_integrations")
}

model BankLoyaltyTransaction {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  userId        String   @db.ObjectId
  bank          String   // KHAN | GOLOMT | TDB
  bankPoints    Int
  esellerPoints Int
  rate          Float    // 1 bank point = X eseller points
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("bank_loyalty_transactions")
}

// ══════════════════════════════════════════════════════════════
// DROPSHIP ORDERS
// ══════════════════════════════════════════════════════════════

model DropshipOrder {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  orderId         String   @unique @db.ObjectId
  supplierOrderId String?
  status          String   @default("PENDING") // PENDING | ORDERED | SHIPPED | DELIVERED | FAILED
  trackingNumber  String?
  trackingUrl     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id])

  @@map("dropship_orders")
}

// ══════════════════════════════════════════════════════════════
// SPRINT 5 — LIVE COMMERCE
// ══════════════════════════════════════════════════════════════

model LiveStream {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  shopId       String   @db.ObjectId
  hostId       String   @db.ObjectId
  title        String
  description  String?
  thumbnailUrl String?
  streamKey    String   @unique @default(cuid())

  // Live scope — 3 төрөл
  scope        String   @default("PUBLIC")  // PUBLIC | SHOP | PRODUCT
  productId    String?  @db.ObjectId        // scope=PRODUCT бол заавал

  // Embed
  youtubeUrl    String?
  facebookUrl   String?
  muxStreamId   String?
  muxPlaybackId String?
  embedType     String  @default("YOUTUBE") // YOUTUBE | FACEBOOK | MUX

  status       String   @default("SCHEDULED") // SCHEDULED | LIVE | ENDED
  viewerCount  Int      @default(0)
  startedAt    DateTime?
  endedAt      DateTime?
  scheduledAt  DateTime?

  // Төлбөртэй багц
  planRequired String   @default("BASIC") // BASIC | STANDARD | PRO | ENTERPRISE

  createdAt    DateTime @default(now())

  shop     Shop          @relation(fields: [shopId], references: [id])
  host     User          @relation("LiveStreamHost", fields: [hostId], references: [id])
  product  Product?      @relation("LiveStreamProduct", fields: [productId], references: [id])
  products LiveProduct[]
  messages LiveMessage[]

  @@map("live_streams")
}

model LiveProduct {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  streamId   String @db.ObjectId
  productId  String @db.ObjectId
  flashPrice Float?
  flashStock Int?
  soldCount  Int    @default(0)
  isPinned   Boolean @default(false)
  order      Int    @default(0)

  stream  LiveStream @relation(fields: [streamId], references: [id])
  product Product    @relation(fields: [productId], references: [id])

  @@map("live_products")
}

model LiveMessage {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  streamId  String   @db.ObjectId
  userId    String   @db.ObjectId
  content   String
  type      String   @default("TEXT") // TEXT | PURCHASE | LIKE | JOIN
  createdAt DateTime @default(now())

  stream LiveStream @relation(fields: [streamId], references: [id])
  user   User       @relation("LiveMessageUser", fields: [userId], references: [id])

  @@map("live_messages")
}

// ══════════════════════════════════════════════════════════════
// SPRINT 5 — BNPL (Buy Now Pay Later)
// ══════════════════════════════════════════════════════════════

model BNPLApplication {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  userId        String    @db.ObjectId
  orderId       String    @unique @db.ObjectId
  totalAmount   Float
  downPayment   Float
  monthlyAmount Float
  months        Int       // 3, 6, 12
  bank          String    // KHAN | GOLOMT | TDB | HAS
  status        String    @default("PENDING") // PENDING | APPROVED | REJECTED | ACTIVE | COMPLETED | DEFAULTED
  approvedAt    DateTime?
  createdAt     DateTime  @default(now())

  user     User          @relation(fields: [userId], references: [id])
  order    Order         @relation(fields: [orderId], references: [id])
  payments BNPLPayment[]

  @@map("bnpl_applications")
}

model BNPLPayment {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  applicationId String    @db.ObjectId
  dueDate       DateTime
  amount        Float
  paidAt        DateTime?
  status        String    @default("PENDING") // PENDING | PAID | OVERDUE

  application BNPLApplication @relation(fields: [applicationId], references: [id])

  @@map("bnpl_payments")
}

// ══════════════════════════════════════════════════════════════
// SPRINT 5 — МАЛЧИН → ХЭРЭГЛЭГЧ (M2C)
// ══════════════════════════════════════════════════════════════

model HerderShop {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  shopId        String    @unique @db.ObjectId
  province      String
  district      String
  herderName    String
  livestockType String[]  // ['тэмээ','адуу','үхэр','хонь','ямаа']
  isVerified    Boolean   @default(false)
  verifiedAt    DateTime?
  description   String?
  createdAt     DateTime  @default(now())

  shop Shop @relation(fields: [shopId], references: [id])

  @@map("herder_shops")
}

// ══════════════════════════════════════════════════════════════
// SPRINT 5 — SOCIAL COMMERCE
// ══════════════════════════════════════════════════════════════

model SocialPost {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  content   String?
  images    String[]
  shares    Int      @default(0)
  createdAt DateTime @default(now())

  user     User                @relation(fields: [userId], references: [id])
  products SocialPostProduct[]
  likes    SocialLike[]
  comments SocialComment[]

  @@map("social_posts")
}

model SocialPostProduct {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  postId    String @db.ObjectId
  productId String @db.ObjectId

  post    SocialPost @relation(fields: [postId], references: [id])
  product Product    @relation(fields: [productId], references: [id])

  @@map("social_post_products")
}

model SocialLike {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  postId String @db.ObjectId
  userId String @db.ObjectId

  post SocialPost @relation(fields: [postId], references: [id])
  user User       @relation("SocialLikeUser", fields: [userId], references: [id])

  @@unique([postId, userId])
  @@map("social_likes")
}

model SocialComment {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  postId    String   @db.ObjectId
  userId    String   @db.ObjectId
  content   String
  createdAt DateTime @default(now())

  post SocialPost @relation(fields: [postId], references: [id])
  user User       @relation("SocialCommentUser", fields: [userId], references: [id])

  @@map("social_comments")
}

// ══════════════════════════════════════════════════════════════
// SPRINT 5 — GAMIFICATION
// ══════════════════════════════════════════════════════════════

model DailyStreak {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  userId        String   @unique @db.ObjectId
  currentStreak Int      @default(0)
  longestStreak Int      @default(0)
  lastLoginAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("daily_streaks")
}

model Achievement {
  id          String            @id @default(auto()) @map("_id") @db.ObjectId
  key         String            @unique
  name        String
  description String
  icon        String
  points      Int

  userAchievements UserAchievement[]

  @@map("achievements")
}

model UserAchievement {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  userId        String   @db.ObjectId
  achievementId String   @db.ObjectId
  earnedAt      DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id])
  achievement Achievement @relation(fields: [achievementId], references: [id])

  @@unique([userId, achievementId])
  @@map("user_achievements")
}

// ══════════════════════════════════════════════════════════════
// SPRINT 5 — ДИЖИТАЛ БАРАА
// ══════════════════════════════════════════════════════════════

model DigitalProduct {
  id           String @id @default(auto()) @map("_id") @db.ObjectId
  productId    String @unique @db.ObjectId
  fileUrl      String
  fileType     String // pdf, zip, mp4, xlsx
  fileSize     Int    // bytes
  maxDownloads Int    @default(5)

  product   Product           @relation(fields: [productId], references: [id])
  downloads DigitalDownload[]

  @@map("digital_products")
}

model DigitalDownload {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  digitalProductId String   @db.ObjectId
  userId           String   @db.ObjectId
  orderId          String   @db.ObjectId
  downloadCount    Int      @default(0)
  downloadedAt     DateTime @default(now())

  digitalProduct DigitalProduct @relation(fields: [digitalProductId], references: [id])
  user           User           @relation(fields: [userId], references: [id])

  @@map("digital_downloads")
}

// ══════════════════════════════════════════════════════════════
// SPRINT 5 — АЙМГИЙН ХҮРГЭЛТ
// ══════════════════════════════════════════════════════════════

model Province {
  id           String          @id @default(auto()) @map("_id") @db.ObjectId
  name         String          @unique
  code         String          @unique
  deliveryDays Int             @default(7)
  fee          Float           @default(15000)
  isFree       Boolean         @default(false)
  isActive     Boolean         @default(true)

  agents ProvinceAgent[]

  @@map("provinces")
}

model ProvinceAgent {
  id         String  @id @default(auto()) @map("_id") @db.ObjectId
  provinceId String  @db.ObjectId
  userId     String  @db.ObjectId
  phone      String
  address    String
  isActive   Boolean @default(true)

  province Province @relation(fields: [provinceId], references: [id])
  user     User     @relation("ProvinceAgentUser", fields: [userId], references: [id])

  @@map("province_agents")
}

// ══════════════════════════════════════════════════════════════
// SPRINT 5 — ЗАСГИЙН ГАЗРЫН ТЕНДЕР (B2G)
// ══════════════════════════════════════════════════════════════

model GovernmentTender {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  agencyName   String
  title        String
  description  String
  budget       Float
  deadline     DateTime
  requirements String[]
  status       String   @default("OPEN") // OPEN | CLOSED | AWARDED
  createdAt    DateTime @default(now())

  bids TenderBid[]

  @@map("government_tenders")
}

model TenderBid {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  tenderId  String   @db.ObjectId
  shopId    String   @db.ObjectId
  price     Float
  note      String?
  status    String   @default("PENDING") // PENDING | ACCEPTED | REJECTED
  createdAt DateTime @default(now())

  tender GovernmentTender @relation(fields: [tenderId], references: [id])
  shop   Shop             @relation(fields: [shopId], references: [id])

  @@map("tender_bids")
}

// ══════════════════════════════════════════════════════════════
// SOCIAL COMMERCE: QUICK BUY, STORIES, GROUP BUY
// ══════════════════════════════════════════════════════════════

model QuickOrder {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  productId String   @db.ObjectId
  quantity  Int      @default(1)
  invoiceId String?
  status    String   @default("PENDING") // PENDING | PAID | CANCELLED
  createdAt DateTime @default(now())

  user    User    @relation("QuickOrderUser", fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@map("quick_orders")
}

model Story {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  shopId    String?  @db.ObjectId
  userId    String   @db.ObjectId
  imageUrl  String
  productId String?  @db.ObjectId
  caption   String?
  views     Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user    User     @relation("StoryUser", fields: [userId], references: [id])
  product Product? @relation("StoryProduct", fields: [productId], references: [id])

  @@map("stories")
}

model GroupBuy {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  productId    String   @db.ObjectId
  targetCount  Int
  discount     Float    // 0.30 = 30%
  currentCount Int      @default(0)
  status       String   @default("OPEN") // OPEN | COMPLETED | EXPIRED | CANCELLED
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  product Product          @relation("GroupBuyProduct", fields: [productId], references: [id])
  members GroupBuyMember[]

  @@map("group_buys")
}

model GroupBuyMember {
  id         String  @id @default(auto()) @map("_id") @db.ObjectId
  groupBuyId String  @db.ObjectId
  userId     String  @db.ObjectId
  isPaid     Boolean @default(false)
  createdAt  DateTime @default(now())

  groupBuy GroupBuy @relation(fields: [groupBuyId], references: [id])
  user     User     @relation("GroupBuyMemberUser", fields: [userId], references: [id])

  @@unique([groupBuyId, userId])
  @@map("group_buy_members")
}
